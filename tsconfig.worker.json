{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "composite": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/worker/**/*.ts",
    "src/react-app/**/*.ts",
    "src/react-app/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}